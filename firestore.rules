rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() ? (
        (request.auth.token.email != null && request.auth.token.email == 'andika.yuliananta@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ) : true;
    }

    function isTeacher() {
      // Exclusively allow the authorized administrator (Andika Yuliananta)
      return isAdmin();
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isTeacher();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Exams collection
    match /exams/{examId} {
      allow get, list: if true;
      allow create, update, delete: if isTeacher();

      // Subcollection questions
      match /questions/{questionId} {
        allow get, list: if true;
        allow create, update, delete: if isTeacher();
      }
    }

    // Participants collection
    match /participants/{participantId} {
      allow get, list, create, update: if true;
      allow delete: if isTeacher();

      // Answers subcollection
      match /answers/{answerId} {
        allow get, list, create, update: if true;
        allow delete: if isTeacher();
      }
    }

    // Results collection
    match /results/{resultId} {
      allow get, list, create: if true;
      allow update, delete: if isTeacher();
    }

    // Settings collection
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isTeacher();
    }
  }
}
